  "main": "dist/index.js",
  "scripts": {
    "build": "npx tsdown",
    "build:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node --es-module-specifier-resolution=node dist/index.js",
