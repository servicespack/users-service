    "@types/safe-regex": "1.1.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "mongodb-memory-server": "10.4.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "tsdown": "0.20.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
