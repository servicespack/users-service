    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "safe-regex": "2.1.1",
    "swagger-ui-express": "5.0.1",
    "xss": "1.0.15"
